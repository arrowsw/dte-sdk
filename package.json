{
  "name": "dte-sdk",
  "version": "0.3.0",
  "type": "module",
  "description": "TypeScript SDK for Chilean electronic tax documents (DTE): build, stamp (TED), sign and envelope DTEs for the SII, and talk to the SII web services (upload, status, acceptance/claims).",
  "author": "arrowsw",
  "sideEffects": false,
  "main": "./dist/index.min.js",
  "module": "./dist/index.min.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.min.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node.min.js"
    },
    "./portal": {
      "types": "./dist/portal/index.d.ts",
      "default": "./dist/portal.min.js"
    },
    "./pdf": {
      "types": "./dist/pdf/index.d.ts",
      "default": "./dist/pdf.min.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "node": [
        "./dist/node/index.d.ts"
      ],
      "portal": [
        "./dist/portal/index.d.ts"
      ],
      "pdf": [
        "./dist/pdf/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs && npm run build:types",
    "lint": "eslint \"{**/*,*}.{js,ts,jsx,tsx}\"",
    "prettier": "prettier --write \"{src,tests}/**/*.{js,ts,jsx,tsx}\"",
    "test": "jest --config jest.config.cjs",
    "size": "size-limit",
    "mutation": "stryker run",
    "prepare": "npm run build",
    "prepublishOnly": "npm run scan && npm run test && npm run prettier && npm run lint",
    "build:types": "tsc --emitDeclarationOnly --outDir dist && node scripts/add-declaration-extensions.mjs",
    "scan": "node scripts/scan-real-data.mjs",
    "fixtures": "node scripts/make-fixtures.mjs",
    "fixtures:tls": "node scripts/make-tls-fixture.mjs",
    "test:differential": "RUN_DIFFERENTIAL=1 jest --config jest.config.cjs differential"
  },
  "license": "MIT",
  "devDependencies": {
    "@size-limit/esbuild": "12.1.0",
    "@size-limit/file": "12.1.0",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/jest-runner": "9.6.1",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/node-forge": "1.3.14",
    "@types/pngjs": "6.0.5",
    "@zxing/library": "0.23.0",
    "bwip-js": "4.11.4",
    "esbuild": "0.28.2",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "expect-type": "1.3.0",
    "fast-check": "4.10.2",
    "jest": "30.2.0",
    "pdf-lib": "1.17.1",
    "pngjs": "7.0.0",
    "prettier": "3.8.1",
    "size-limit": "12.1.0",
    "ts-jest": "29.4.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.1",
    "xmllint-wasm": "5.3.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "homepage": "https://dte.arrowsw.com",
  "keywords": [
    "dte",
    "documento tributario electronico",
    "factura electronica",
    "boleta electronica",
    "sii",
    "chile",
    "chilean",
    "tax",
    "invoice",
    "node",
    "browser",
    "typescript"
  ],
  "repository": {
    "url": "git+https://github.com/arrowsw/dte-sdk.git",
    "type": "git"
  },
  "bugs": {
    "url": "https://github.com/arrowsw/dte-sdk/issues"
  },
  "files": [
    "dist/**/*.min.js",
    "dist/**/*.min.js.map",
    "dist/**/*.d.ts",
    "src/**/*.ts",
    "LICENSE",
    "README.md",
    "llms.txt"
  ],
  "dependencies": {
    "@xmldom/xmldom": "0.8.15",
    "fast-xml-parser": "5.11.2",
    "node-forge": "1.4.2",
    "rut.ts": "5.0.0"
  },
  "peerDependencies": {
    "bwip-js": "^4.11.4",
    "pdf-lib": "^1.17.1"
  },
  "peerDependenciesMeta": {
    "bwip-js": {
      "optional": true
    },
    "pdf-lib": {
      "optional": true
    }
  }
}
